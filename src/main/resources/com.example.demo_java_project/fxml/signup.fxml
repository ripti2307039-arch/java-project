<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="rootPane" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo_java_project.controller.SignupController"
      stylesheets="@../css/login.css">

    <VBox styleClass="left-panel" alignment="CENTER" spacing="18" HBox.hgrow="ALWAYS">
        <Region styleClass="deco-circle-1" />
        <Label text="SlotSync" styleClass="brand-title" />
        <Label text="Join SlotSync and never miss a slot again." styleClass="brand-tagline" wrapText="true" textAlignment="CENTER" maxWidth="320" />
        <Region styleClass="deco-circle-2" />
    </VBox>

    <VBox styleClass="right-panel" alignment="CENTER" HBox.hgrow="ALWAYS">
        <VBox styleClass="login-card" alignment="CENTER" spacing="14" maxWidth="360">

            <Label text="Create Account" styleClass="card-title" />
            <Label text="Start booking resources in seconds" styleClass="card-subtitle" />

            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Full Name" styleClass="field-label" />
                <TextField fx:id="fullNameField" promptText="Your full name" styleClass="input-field" />
            </VBox>

            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Email" styleClass="field-label" />
                <TextField fx:id="emailField" promptText="you@example.com" styleClass="input-field" />
            </VBox>

            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Password" styleClass="field-label" />
                <PasswordField fx:id="passwordField" promptText="At least 6 characters" styleClass="input-field" />
            </VBox>

            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Confirm Password" styleClass="field-label" />
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password" styleClass="input-field" />
            </VBox>

            <Label fx:id="messageLabel" styleClass="error-label" wrapText="true" maxWidth="320" visible="false" managed="false" />

            <StackPane>
                <Button fx:id="signupButton" text="Sign Up" styleClass="primary-button" maxWidth="Infinity" onAction="#handleSignup" />
                <ProgressIndicator fx:id="loadingIndicator" styleClass="loading-spinner" maxWidth="24" maxHeight="24" visible="false" managed="false" />
            </StackPane>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Already have an account?" styleClass="signup-text" />
                <Hyperlink fx:id="loginLink" text="Login" styleClass="signup-link" onAction="#handleLoginLink" />
            </HBox>

        </VBox>
    </VBox>

</HBox>